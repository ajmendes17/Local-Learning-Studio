      "dot": "emerald",
      "title": "Ownership",
      "items": [
        "SQLite owns structured course and attempt records.",
        "Obsidian is a user-owned, human-readable companion.",
        "Every lookup and export stays within one course ID."
      ]
    },
    {
      "dot": "cyan",
      "title": "Sync contract to decide",
      "items": [
        "Use stable course-local note IDs and frontmatter.",
        "Separate app-managed blocks from learner-authored Markdown.",
        "Never silently overwrite edits; surface conflicts for review."
      ]
    },
    {
      "dot": "amber",
      "title": "Learning response",
      "items": [
        "After a miss or low-confidence correct answer, explain and offer a new question or representation.",
        "Prefer retrying the concept with a different item; exact-question retry is an optional immediate check.",
        "Use existing evaluate-learner-response and plan-remediation skills for free response and next-step proposals."
