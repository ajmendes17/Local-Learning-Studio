{
  "name": "local-learning-studio",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first, Codex-powered learning workspace.",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/contracts",
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "predev": "npm run build --workspace @local-learning-studio/contracts",
    "dev": "concurrently --kill-others --names server,web --prefix-colors cyan,magenta \"npm run dev:server\" \"npm run dev:web\"",
    "predev:server": "npm run build --workspace @local-learning-studio/contracts",
    "dev:server": "npm run dev --workspace @local-learning-studio/server",
    "dev:web": "npm run dev --workspace @local-learning-studio/web",
    "build": "npm run build --workspace @local-learning-studio/contracts && npm run build --workspace @local-learning-studio/server && npm run build --workspace @local-learning-studio/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretest": "npm run build --workspace @local-learning-studio/contracts",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "typescript": "^7.0.2"
  }
}
